---
import { showPhotography } from "../config/site";
const target = showPhotography ? "/#photos" : "/#graphics";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Redirecting...</title>
  </head>
  <body>
    <p><a href={target}>Continue to Portfolio</a></p>
  </body>
</html>
